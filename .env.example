# Copy to .env and fill in. All values here have sane local-dev defaults in settings.py;
# you only need this file to override them.

# --- LLM provider ---
LLM_PROVIDER=ollama          # "ollama" (local, free) or "anthropic" (paid API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# ANTHROPIC_API_KEY=         # only needed when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Embeddings (local, free) ---
EMBEDDING_MODEL_NAME=pritamdeka/S-PubMedBert-MS-MARCO

# --- Vector store ---
CHROMA_PERSIST_DIR=./database/chroma_store
CHROMA_COLLECTION_NAME=alzheimer_papers

# --- Retrieval / ingestion ---
# Free NCBI API key raises E-utilities rate limits from 3 to 10 req/sec: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# Unpaywall requires a real contact email for its free API (no key needed): https://unpaywall.org/products/api
UNPAYWALL_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# --- Agent behavior ---
DEFAULT_NUM_PAPERS=5
MAX_NUM_PAPERS=25
LLM_MAX_OUTPUT_TOKENS=700
RETRIEVAL_CANDIDATE_K=15
CONVERSATION_REFRESH_MAX_RESULTS=20   # per-source cap for the first-message live corpus refresh

# --- Voice input (local speech-to-text, no cost) ---
WHISPER_MODEL_SIZE=base   # tiny|base|small|medium|large-v3 — bigger = more accurate, slower

# --- Backend / frontend ---
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
